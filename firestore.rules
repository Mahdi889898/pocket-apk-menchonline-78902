rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'avatarIndex', 'wins', 'gamesPlayed', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'displayName', 'avatarIndex', 'wins', 'gamesPlayed', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30 &&
             data.avatarIndex is int && data.avatarIndex >= 0 && data.avatarIndex <= 7 &&
             data.wins is int && data.wins >= 0 &&
             data.gamesPlayed is int && data.gamesPlayed >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRoom(data) {
      return data.keys().hasAll([
               'roomCode', 'hostUid', 'title', 'visibility', 'status',
               'memberUids', 'seatUids', 'seatNames', 'seatTypes',
               'seatMuted', 'seatSpeaking', 'pieces', 'currentTurn',
               'diceValue', 'turnPhase', 'consecutiveSixes', 'winnerSeat',
               'lastActionText', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'roomCode', 'hostUid', 'title', 'visibility', 'status',
               'memberUids', 'seatUids', 'seatNames', 'seatTypes',
               'seatMuted', 'seatSpeaking', 'pieces', 'currentTurn',
               'diceValue', 'turnPhase', 'consecutiveSixes', 'winnerSeat',
               'lastActionText', 'createdAt', 'updatedAt'
             ]) &&
             data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16 && data.roomCode.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 40 &&
             data.visibility in ['public', 'private'] &&
             data.status in ['waiting', 'playing', 'finished'] &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 4 && data.memberUids[0] is string &&
             data.seatUids is list && data.seatUids.size() == 4 && data.seatUids[0] is string &&
             data.seatNames is list && data.seatNames.size() == 4 && data.seatNames[0] is string &&
             data.seatTypes is list && data.seatTypes.size() == 4 && data.seatTypes.hasOnly(['empty', 'human', 'bot']) &&
             data.seatMuted is list && data.seatMuted.size() == 4 && data.seatMuted.hasOnly([true, false]) &&
             data.seatSpeaking is list && data.seatSpeaking.size() == 4 && data.seatSpeaking.hasOnly([true, false]) &&
             data.pieces is list && data.pieces.size() == 16 && data.pieces[0] is int &&
             data.currentTurn is int && data.currentTurn >= 0 && data.currentTurn <= 3 &&
             data.diceValue is int && data.diceValue >= 0 && data.diceValue <= 6 &&
             data.turnPhase in ['roll', 'move'] &&
             data.consecutiveSixes is int && data.consecutiveSixes >= 0 && data.consecutiveSixes <= 3 &&
             data.winnerSeat is int && data.winnerSeat >= -1 && data.winnerSeat <= 3 &&
             data.lastActionText is string && data.lastActionText.size() <= 120 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSignal(data) {
      return data.keys().hasAll(['roomId', 'senderUid', 'targetUid', 'memberUids', 'type', 'sdp', 'sdpMid', 'sdpMLineIndex', 'createdAt']) &&
             data.keys().hasOnly(['roomId', 'senderUid', 'targetUid', 'memberUids', 'type', 'sdp', 'sdpMid', 'sdpMLineIndex', 'createdAt']) &&
             data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.targetUid is string && data.targetUid.size() >= 1 && data.targetUid.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 4 && data.memberUids[0] is string &&
             data.type in ['offer', 'answer', 'ice'] &&
             data.sdp is string && data.sdp.size() <= 12000 &&
             data.sdpMid is string && data.sdpMid.size() <= 64 &&
             data.sdpMLineIndex is int && data.sdpMLineIndex >= 0 && data.sdpMLineIndex <= 10 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['roomId', 'senderUid', 'senderName', 'memberUids', 'text', 'createdAt']) &&
             data.keys().hasOnly(['roomId', 'senderUid', 'senderName', 'memberUids', 'text', 'createdAt']) &&
             data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 30 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 4 && data.memberUids[0] is string &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 120 &&
             isValidTimestamp(data.createdAt);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().wins == 0 &&
                       incoming().gamesPlayed == 0 &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarIndex', 'wins', 'gamesPlayed', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && (
        request.auth.uid in existing().memberUids ||
        existing().status == 'waiting'
      );

      allow list: if isSignedIn() && (
        request.auth.uid in existing().memberUids ||
        (existing().visibility == 'public' && existing().status == 'waiting')
      );

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().roomCode == roomId &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().memberUids.size() == 1 &&
                       incoming().memberUids[0] == request.auth.uid &&
                       incoming().status == 'waiting' &&
                       incoming().winnerSeat == -1;

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       existing().status != 'finished' &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().visibility == existing().visibility &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Join or leave while waiting
                         (
                           existing().status == 'waiting' &&
                           incoming().status == 'waiting' &&
                           (request.auth.uid in incoming().memberUids || request.auth.uid in existing().memberUids) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'memberUids', 'seatUids', 'seatNames', 'seatTypes',
                             'seatMuted', 'lastActionText', 'updatedAt'
                           ])
                         ) ||
                         // Action 2: Host starts the game
                         (
                           existing().status == 'waiting' &&
                           incoming().status == 'playing' &&
                           request.auth.uid == existing().hostUid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'status', 'seatNames', 'seatTypes', 'currentTurn',
                             'diceValue', 'turnPhase', 'lastActionText', 'updatedAt'
                           ])
                         ) ||
                         // Action 3: Room member executes turn roll/move or completes game
                         (
                           existing().status == 'playing' &&
                           request.auth.uid in existing().memberUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'pieces', 'currentTurn', 'diceValue', 'turnPhase',
                             'consecutiveSixes', 'winnerSeat', 'status',
                             'lastActionText', 'updatedAt'
                           ])
                         ) ||
                         // Action 4: Room member updates voice mute / speaking state
                         (
                           request.auth.uid in existing().memberUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'seatMuted', 'seatSpeaking', 'updatedAt'
                           ])
                         ) ||
                         // Action 5: Member leaves active game (seat converts to bot)
                         (
                           existing().status == 'playing' &&
                           request.auth.uid in existing().memberUids &&
                           !(request.auth.uid in incoming().memberUids) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'memberUids', 'seatUids', 'seatNames', 'seatTypes',
                             'seatMuted', 'seatSpeaking', 'lastActionText', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(roomId) &&
                       (
                         (existing().hostUid == request.auth.uid && existing().status == 'waiting') ||
                         (request.auth.uid in existing().memberUids && existing().memberUids.size() == 1)
                       );

      match /signals/{signalId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(signalId) && (
          existing().targetUid == request.auth.uid || existing().senderUid == request.auth.uid
        );

        allow list: if isSignedIn() && existing().targetUid == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(signalId) &&
                         isValidSignal(incoming()) &&
                         incoming().roomId == roomId &&
                         incoming().senderUid == request.auth.uid &&
                         incoming().senderUid in incoming().memberUids &&
                         incoming().targetUid in incoming().memberUids &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids &&
                         incoming().targetUid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;

        allow update: if false;

        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(signalId) && (
          existing().targetUid == request.auth.uid || existing().senderUid == request.auth.uid
        );
      }

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId) &&
                      request.auth.uid in existing().memberUids;

        allow list: if isSignedIn() && request.auth.uid in existing().memberUids;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         isValidMessage(incoming()) &&
                         incoming().roomId == roomId &&
                         incoming().senderUid == request.auth.uid &&
                         incoming().senderUid in incoming().memberUids &&
                         exists(/databases/$(database)/documents/rooms/$(roomId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;

        allow update: if false;

        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(messageId) &&
                         existing().senderUid == request.auth.uid;
      }
    }
  }
}
